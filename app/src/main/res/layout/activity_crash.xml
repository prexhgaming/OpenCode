<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/opencode_dark_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/crash_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/opencode_dark_surface"
        app:elevation="4dp"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/crash_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/opencode_dark_surface"
            app:title="Application error"
            app:titleTextColor="@color/opencode_dark_text"
            app:navigationIcon="@drawable/ic_restart"
            app:navigationContentDescription="Restart application"
            app:menu="@menu/crash_menu"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Dark" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/crash_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="16dp"
        android:scrollbars="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/opencode_dark_surface"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <TextView
                android:id="@+id/crash_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/opencode_dark_text"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:textIsSelectable="false"
                android:longClickable="false"
                android:breakStrategy="simple"
                android:padding="16dp"
                android:text="Crash details will appear here." />
        </com.google.android.material.card.MaterialCardView>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>