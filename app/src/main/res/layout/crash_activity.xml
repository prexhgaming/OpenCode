<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/opencode_dark_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/crash_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/opencode_dark_surface"
        android:elevation="4dp"
        app:title="Application error"
        app:titleTextColor="@color/opencode_dark_text"
        app:navigationIcon="@drawable/ic_restart"
        app:navigationContentDescription="Restart application"
        app:menu="@menu/crash_menu"
        app:popupTheme="@style/ThemeOverlay.MaterialComponents.Dark" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/crash_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="16dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/crash_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/opencode_dark_text"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="false"
            android:longClickable="false"
            android:breakStrategy="simple"
            android:paddingBottom="24dp"
            android:text="Crash details will appear here." />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
